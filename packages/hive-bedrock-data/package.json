{
  "name": "hive-bedrock-data",
  "version": "4.5.0",
  "description": "A repo to store and calculate data and type definitions from The Hive: Bedrock Edition server.",

  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/CubeEdge-Studios/hive-bedrock.git"
  },
  "license": "MIT",
  "author": "Cubeedge Studios",

  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.1.3"
  },
  "gitHead": "8f838dffc216cb0756a1a5b4c767d9ba173dda6c"
}
